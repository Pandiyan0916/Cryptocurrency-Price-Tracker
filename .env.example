# CoinPulse Environment Variables (Optional)
# Copy to .env to customize local server configuration

# Optional CoinGecko Demo or Pro API Key
COINGECKO_API_KEY=

# Optional Override for Upstream API URL (for testing or proxy)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Server Cache TTL Overrides (seconds)
CACHE_TTL_MARKETS=60
CACHE_TTL_GLOBAL=120
CACHE_TTL_CHART=300
CACHE_TTL_DETAIL=600
CACHE_TTL_TRENDING=600
